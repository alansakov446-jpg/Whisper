# Telegram bot token from @BotFather
BOT_TOKEN=

# Neon (or any Postgres) connection string.
# sqlite is only for local experiments — GitHub Actions requires Postgres.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Fernet key. Generate: python scripts/generate_fernet_key.py
# Do not change it after the first anonymous whisper — sender ids would be unreadable.
FERNET_KEY=

# Health server (cron-job.org / probes)
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Optional outbound heartbeat (healthchecks.io). Leave empty to disable.
HEARTBEAT_URL=

# Optional private git repo for pg_dump backups, with credentials in the URL.
# Example: https://x-access-token:TOKEN@github.com/you/whisper-backups.git
BACKUP_REPO_URL=
BACKUP_INTERVAL_MINUTES=30

# Optional web preview base URL. 5-minute preview links are built on top of it.
# Leave empty to disable ("Веб-превью выключено").
WEB_BASE_URL=

LOG_LEVEL=INFO
